rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
// Firestore Security Rules — Anime1Point Creators Hub
//
// COLLECTION ARCHITECTURE:
//   creatorApplications/{uid}  — Pending/rejected/approved applications queue
//   creators/{uid}             — Live approved creators (feeds active)
//   creatorSlugs/{slug}        — Public slug → uid mapping (read by React SPA)
//   viewers/{uid}              — Viewer profiles (Google/Email/OTP users)
//
// HOW TO DEPLOY:
//   Option A (recommended): Firebase CLI
//     firebase deploy --only firestore:rules --project anime1point-hub
//
//   Option B: Firebase Console
//     Firestore Database → Rules → paste this file content → Publish
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the caller signed in? ────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    // ── Helper: is this the caller's own document? ───────────────────────────
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ── Helper: check that a field is NOT being written ──────────────────────
    // Used to prevent creators from writing their own encrypted API key field.
    // The encrypted key is written by the Cloud Function (server-side) only.
    function notWritingField(field) {
      return !(field in request.resource.data);
    }

    // =========================================================================
    // creatorApplications/{uid}
    // =========================================================================
    // - Creators can CREATE and UPDATE their own application.
    // - Creators CANNOT write the encrypted API key field (server-side only).
    // - Creators CANNOT change their own status field (admin only).
    // - Creators can READ their own application (to check status).
    // - No one else can read applications (prevents data scraping).
    match /creatorApplications/{uid} {
      // Creator can read their own application (e.g. to check status)
      allow read: if isOwner(uid);

      // Creator can create their application
      allow create: if isOwner(uid)
        && notWritingField('youtubeApiKeyEncrypted')
        && notWritingField('hasApiKey')
        && request.resource.data.status == 'pending'
        && request.resource.data.uid == request.auth.uid;

      // Creator can update their own application (e.g. edit channel details)
      // but cannot change status or the encrypted API key directly.
      allow update: if isOwner(uid)
        && notWritingField('youtubeApiKeyEncrypted')
        && notWritingField('hasApiKey')
        && (!('status' in request.resource.data)
            || request.resource.data.status == resource.data.status);

      // Deny all other operations (admin uses Cloud Functions / Admin SDK)
      allow delete: if false;
    }

    // =========================================================================
    // creators/{uid}
    // =========================================================================
    // - Public READ allowed (so React SPA can load creator profiles).
    //   The encrypted API key is opaque (encrypted) — safe to return.
    // - WRITES only allowed by server-side (Cloud Functions / Admin SDK).
    //   Creators and viewers cannot write to this collection.
    match /creators/{uid} {
      // Public read — React SPA needs this to load live creator profiles
      allow read: if true;

      // No client-side writes — admin dashboard uses Admin SDK (bypasses rules)
      allow write: if false;
    }

    // =========================================================================
    // creatorSlugs/{slug}
    // =========================================================================
    // - Public READ (React SPA looks up slug → uid to show live feed badge).
    // - No client-side writes (admin dashboard uses Admin SDK).
    match /creatorSlugs/{slug} {
      allow read:  if true;
      allow write: if false;
    }

    // =========================================================================
    // viewers/{uid}
    // =========================================================================
    // - Viewers can read and write only their own profile.
    match /viewers/{uid} {
      allow read, write: if isOwner(uid);
    }

    // =========================================================================
    // Default: deny everything else
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
