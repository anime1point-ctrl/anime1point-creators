—rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
// Firestore Security Rules — Anime1Point Creators Hub
//
// COLLECTION ARCHITECTURE:
// creatorApplications/{uid}          — Moderation queue
// creators/{uid}                     — Live approved creators
// creatorSlugs/{slug}                — Public slug → uid mapping
// viewers/{uid}                      — Viewer profiles
// creatorRatings/{creatorId_viewerUid} — One rating per viewer per creator
//
// DEPLOY:
//   firebase deploy --only firestore:rules --project anime1point-hub
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function notWritingField(field) {
      return !(field in request.resource.data);
    }

    // =========================================================================
    // creatorApplications/{uid}
    // =========================================================================
    match /creatorApplications/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && notWritingField('youtubeApiKeyEncrypted')
                    && notWritingField('hasApiKey')
                    && request.resource.data.status == 'pending'
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(uid)
                    && notWritingField('youtubeApiKeyEncrypted')
                    && notWritingField('hasApiKey')
                    && (!('status' in request.resource.data)
                        || request.resource.data.status == resource.data.status);
      allow delete: if false;
    }

    // =========================================================================
    // creators/{uid}
    // =========================================================================
    // Public READ — React SPA needs this for profile pages.
    // The ratingAverage / ratingCount fields are written here by the
    // submitRating Cloud Function (Admin SDK) — not by the client.
    // Client writes are disabled entirely; all mutations go via Cloud Functions.
    match /creators/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // =========================================================================
    // creatorSlugs/{slug}
    // =========================================================================
    match /creatorSlugs/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // =========================================================================
    // viewers/{uid}
    // =========================================================================
    match /viewers/{uid} {
      allow read, write: if isOwner(uid);
    }

    // =========================================================================
    // creatorRatings/{docId}
    // docId format: {creatorId}_{viewerUid}
    //
    // READ rules:
    //   - Anyone can read aggregate stats (ratingAverage/ratingCount)
    //     from the creator document (not from here).
    //   - A viewer can read their own rating doc to know if they've rated.
    //     The docId encodes both IDs, so we extract viewerUid from the path.
    //
    // WRITE rules:
    //   - Writes go through the submitRating Cloud Function (Admin SDK).
    //   - Client-side direct writes are blocked.
    //     This ensures the aggregate on the creator document is always updated
    //     atomically in the same transaction as the rating write.
    // =========================================================================
    match /creatorRatings/{docId} {
      // Allow a viewer to read their own rating (to pre-fill the star UI)
      // The docId is {creatorId}_{viewerUid}. We split on the last underscore
      // by checking that the doc's viewerUid field matches the caller.
      allow read: if signedIn()
                  && resource != null
                  && resource.data.viewerUid == request.auth.uid;

      // All writes go through the Cloud Function (Admin SDK bypasses rules)
      allow write: if false;
    }

    // =========================================================================
    // Default: deny everything else
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
